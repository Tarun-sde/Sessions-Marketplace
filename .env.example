# ==============================================================================
# Ahoum Sessions Marketplace - Environment Configuration (.env.example)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=ahoum_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Backend Configuration
SECRET_KEY=django-insecure-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx,0.0.0.0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80,http://127.0.0.1,http://127.0.0.1:5173

# Authentication & Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH_DEV_MODE=True
